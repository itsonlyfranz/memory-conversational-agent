# Copy to .env (gitignored) and fill in. Only needed for live runs; tests and `demo` run offline.
ANTHROPIC_API_KEY=
# Optional overrides
MEMORY_AGENT_MODEL=claude-sonnet-5-5
MEMORY_AGENT_DATA_DIR=.memory_data
# Short-term buffer budget (approx. tokens) before older turns are compressed into a summary
MEMORY_AGENT_MAX_CONTEXT_TOKENS=1200
